    <Compile Include="..\StorageHub.Agent\Scheduling\ScheduledSyncJobContracts.cs"
             Link="Scheduling\ScheduledSyncJobContracts.cs" />
    <Compile Include="..\StorageHub.Agent\Scheduling\CronScheduleDefinition.cs"
             Link="Scheduling\CronScheduleDefinition.cs" />
  </ItemGroup>
</Project>
